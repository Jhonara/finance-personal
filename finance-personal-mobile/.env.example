# Select one environment and provide its API base URL, including /api/v1.
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1
# On a physical phone, use the computer's LAN address instead, e.g. http://192.168.1.55:8080/api/v1.
# The phone and computer must share a local network; an Expo tunnel does not expose this API.
# Used only by npm run api:generate. It points to the backend OpenAPI document.
OPENAPI_URL=http://localhost:8080/v3/api-docs
